{
  "name": "@hyuga/tenken",
  "version": "0.3.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@hyuga/tenken",
      "version": "0.3.0",
      "license": "MIT",
      "dependencies": {
        "@hyuga/carrylint": "^0.2.2",
        "@hyuga/reflint": "^0.9.0",
        "@hyuga/skills-lint": "^0.7.0"
      },
      "bin": {
        "tenken": "src/check.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "../agents-lint": {
      "name": "@hyuga/reflint",
      "version": "0.9.1",
      "license": "MIT",
      "bin": {
        "reflint": "src/check.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "../carrylint": {
      "name": "@hyuga/carrylint",
      "version": "0.2.3",
      "license": "MIT",
      "bin": {
        "carrylint": "src/check.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "../skills-lint": {
      "name": "@hyuga/skills-lint",
      "version": "0.7.2",
      "license": "MIT",
      "bin": {
        "skills-lint": "src/check.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@hyuga/carrylint": {
      "resolved": "../carrylint",
      "link": true
    },
    "node_modules/@hyuga/reflint": {
      "resolved": "../agents-lint",
      "link": true
    },
    "node_modules/@hyuga/skills-lint": {
      "resolved": "../skills-lint",
      "link": true
